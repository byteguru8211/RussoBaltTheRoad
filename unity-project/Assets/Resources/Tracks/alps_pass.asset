  storyTitle: "\u0427\u0435\u0440\u0435\u0437 \u0410\u043B\u044C\u043F\u044B"
  storyText: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F, \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u043A\u0440\u0443\u0447\u0435, \u0430 \u0442\u0443\u043C\u0430\u043D \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u0442\u043E\u0447\u043A\u0443. \u041D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439\u0442\u0435 \u043E \u0437\u0430\u0434\u043D\u0438\u0445 \u0442\u043E\u0440\u043C\u043E\u0437\u0430\u0445 \u0438 \u0442\u0435\u043F\u043B\u043E\u0440\u0435\u0436\u0438\u043C\u0435."
